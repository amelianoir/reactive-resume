# Vercel + Supabase Deployment Configuration
# Copy this file and configure for your deployment

# ============================================
# APPLICATION SETTINGS
# ============================================

# Your Vercel deployment URL
# After first deploy, update this to your actual URL
APP_URL="https://your-app.vercel.app"

# Optional: URL for printer to access the app
# Usually the same as APP_URL for Vercel deployments
PRINTER_APP_URL="https://your-app.vercel.app"

# Timezone (optional)
TZ="Etc/UTC"

# ============================================
# SUPABASE DATABASE
# ============================================

# Get this from Supabase Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxxxxxxx.supabase.co:5432/postgres"

# ============================================
# PRINTER SERVICE (PDF GENERATION)
# ============================================

# Option 1: Browserless Cloud (recommended for easy setup)
# Sign up at https://www.browserless.io/ and get your API key
PRINTER_ENDPOINT="wss://chrome.browserless.io?token=YOUR_BROWSERLESS_API_KEY"

# Option 2: Self-hosted Browserless
# Deploy Browserless separately and use its URL
# PRINTER_ENDPOINT="ws://your-browserless-instance.com:3000?token=your-secret-token"

# Option 3: Other headless Chrome service
# Use any Chrome DevTools Protocol compatible service
# PRINTER_ENDPOINT="ws://your-chrome-service.com:9222"

# ============================================
# AUTHENTICATION
# ============================================

# Generate a secure secret key using: openssl rand -hex 32
# This is critical for security - use a unique, random value
AUTH_SECRET="your-generated-secret-key-replace-this-with-actual-secret"

# ============================================
# SUPABASE STORAGE (S3-COMPATIBLE)
# ============================================

# Get these from Supabase Dashboard → Settings → API
# Project ID (Settings → General → Reference ID)
S3_ACCESS_KEY_ID="your-supabase-project-id"

# Service Role Key (Settings → API → service_role key)
# ⚠️ Keep this secret! Never expose to client-side code
S3_SECRET_ACCESS_KEY="your-supabase-service-role-key"

# Storage region (use 'auto' or your project's region)
S3_REGION="auto"

# Supabase S3 endpoint
# Format: https://[YOUR-20-CHAR-PROJECT-REF].supabase.co/storage/v1/s3
# Replace [YOUR-20-CHAR-PROJECT-REF] with your actual Supabase project reference (20 characters)
S3_ENDPOINT="https://abcdefghijklmnopqrst.supabase.co/storage/v1/s3"

# Bucket name (create this in Supabase Storage dashboard)
S3_BUCKET="reactive-resume"

# Use virtual-hosted-style URLs (false for Supabase)
S3_FORCE_PATH_STYLE="false"

# ============================================
# OAUTH PROVIDERS (OPTIONAL)
# ============================================

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Custom OAuth Provider (optional)
OAUTH_PROVIDER_NAME=""
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
# Use EITHER discovery URL (preferred for OIDC-compliant providers):
OAUTH_DISCOVERY_URL=""
# OR manual URLs (all three required if not using discovery):
OAUTH_AUTHORIZATION_URL=""
OAUTH_TOKEN_URL=""
OAUTH_USER_INFO_URL=""
# Custom scopes (space-separated, defaults to "openid profile email")
OAUTH_SCOPES=""

# ============================================
# EMAIL (SMTP) - OPTIONAL
# ============================================

# If not configured, emails will be logged to Vercel function logs
# Configure SMTP to send verification emails, password resets, etc.

# SMTP Server Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Reactive Resume <noreply@yourdomain.com>"
SMTP_SECURE="false"

# Gmail example:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"  # Use App Password, not regular password
# SMTP_SECURE="false"

# ============================================
# FEATURE FLAGS
# ============================================

# Debug printer endpoint (useful for testing, keep false in production)
FLAG_DEBUG_PRINTER="false"

# Disable new user registrations (useful for private instances)
FLAG_DISABLE_SIGNUPS="false"

# Disable email/password authentication (only allow OAuth)
FLAG_DISABLE_EMAIL_AUTH="false"

# ============================================
# DEPLOYMENT NOTES
# ============================================

# Vercel Deployment Steps:
# 1. Create a new Supabase project and note the connection details
# 2. Set up Supabase Storage bucket named "reactive-resume"
# 3. Get a Browserless account or deploy your own printer service
# 4. In Vercel project settings, add all these variables to Environment Variables
# 5. Deploy your application
# 6. After first deploy, update APP_URL with your actual Vercel URL
# 7. Redeploy to apply the updated APP_URL

# Important Security Notes:
# ⚠️ CRITICAL: This is an EXAMPLE file. Never commit actual secrets to version control!
# - Keep this file (or your copy) in .gitignore if you add real credentials
# - Use Vercel's Environment Variables UI to set production values
# - Never commit files with real values of S3_SECRET_ACCESS_KEY, AUTH_SECRET, or other secrets
# - Rotate S3_SECRET_ACCESS_KEY and AUTH_SECRET periodically
# - Keep your service role key secure - it has full database access

# Vercel Limitations:
# - Free tier: 10-second function timeout
# - Pro tier: 60-second function timeout
# - Consider these limits for PDF generation operations
# - You may need Pro plan for production use with heavy PDF generation

# Cost Considerations:
# - Vercel Free: 100 GB bandwidth, 6K build minutes
# - Supabase Free: 500 MB database, 1 GB storage, pauses after 7 days inactive
# - Browserless Free: 6 hours/month
# - Monitor usage in respective dashboards

# Support:
# - Documentation: https://docs.rxresu.me/self-hosting/vercel-supabase
# - Issues: https://github.com/amruthpillai/reactive-resume/issues
# - Discord: https://discord.gg/hzwkZbyvUW
